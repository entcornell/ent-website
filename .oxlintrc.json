{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "oxc", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/react-in-jsx-scope": "off",
    "no-console": [
      "warn",
      {
        "allow": ["warn", "error"]
      }
    ],
    "max-lines": [
      "warn",
      {
        "max": 800,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-depth": [
      "warn",
      {
        "max": 4
      }
    ]
  },
  "ignorePatterns": ["dist", "coverage"],
  "overrides": [
    {
      "files": ["src/**/*Data.js"],
      "rules": {
        "max-lines": "off"
      }
    }
  ]
}
