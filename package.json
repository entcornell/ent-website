{
  "name": "ent-website",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.0.0",
    "@fortawesome/free-brands-svg-icons": "^7.0.0",
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "@fortawesome/react-fontawesome": "^0.2.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint --deny-warnings",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "deadcode": "knip --no-progress",
    "hooks:install": "git config core.hooksPath .githooks",
    "check": "npm run lint && npm run format:check && npm test && npm run deadcode",
    "images": "node scripts/optimize-images.mjs",
    "readme:assets": "node scripts/readme-assets.mjs"
  },
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "knip": "^6.45.0",
    "oxlint": "^1.93.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
